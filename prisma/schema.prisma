generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum UserRole {
  GENERAL
  VENDOR
  ADMIN
}

enum VendorApprovalStatus {
  NOT_APPLICABLE
  PENDING
  APPROVED
  REJECTED
}

enum EventType {
  WEDDING
  FUNERAL
  BIRTHDAY
  BABY_SHOWER
  HOUSEWARMING
  FIRST_BIRTHDAY
  MEMORIAL
  ETC
}

enum EventStatus {
  DRAFT
  ACTIVE
  PLANNING
  PUBLISHED
  COMPLETED
  CANCELLED
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  REJECTED
  CHANGED
  CANCELED
  COMPLETED
}

enum QuoteStatus {
  PENDING
  RESPONDED
  ACCEPTED
  CANCELED
}

enum QuoteProposalRevisionStatus {
  SUBMITTED
  ADJUSTMENT_REQUESTED
  REVISED
  ACCEPTED
}

enum TransactionStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  CANCELLED
}

enum TransactionMethod {
  MOCK
  CARD
  BANK_TRANSFER
  CASH
}

enum TransactionType {
  ONLINE
  OFFLINE
}

enum ModuleCategory {
  VENUE
  PHOTO
  DRESS
  MAKEUP
  DECORATION
  CATERING
  INVITATION
  FUNERAL_HALL
  WREATH
  TRANSPORT
  CEREMONY
  MEAL
  OBITUARY
}

enum VendorPackageModuleSelectionType {
  INCLUDED
  OPTIONAL
}

enum PostCategory {
  NOTICE
  STORY
  QNA
  REVIEW
  PROMOTION
}

enum InvitationStatus {
  DRAFT
  SENT
  VIEWED
  RSVP_ACCEPTED
  RSVP_DECLINED
}

model User {
  id                      String                @id @default(cuid())
  email                   String                @unique
  name                    String
  passwordHash            String
  role                    UserRole              @default(GENERAL)
  phone                   String?               @unique
  companyName             String?
  bio                     String?
  supportedEventTypes     Json?
  supportedServiceModules Json?
  imageUrl                String?
  location                String?
  emailVerifiedAt         DateTime?
  phoneVerifiedAt         DateTime?
  isActive                Boolean               @default(true)
  vendorApprovalStatus    VendorApprovalStatus  @default(NOT_APPLICABLE)
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  ownedEventPlans         EventPlan[]           @relation("EventOwner")
  vendorReservations      Reservation[]         @relation("ReservationVendor")
  authoredPosts           Post[]                @relation("PostAuthor")
  writtenReviews          Review[]              @relation("ReviewAuthor")
  receivedReviews         Review[]              @relation("ReviewVendor")
  payerTransactions       Transaction[]         @relation("TransactionPayer")
  sentInvitations         Invitation[]          @relation("InvitationSender")
  receivedInvitations     Invitation[]          @relation("InvitationRecipient")
  vendorServices          VendorService[]       @relation("VendorServices")
  vendorServiceModules    VendorServiceModule[] @relation("VendorServiceModules")
  vendorPackages          VendorPackage[]       @relation("VendorPackages")
  quoteRequests           QuoteRequest[]        @relation("QuoteRequestVendor")
  quoteResponses          QuoteResponse[]       @relation("QuoteResponseVendor")
  quoteProposalRevisions  QuoteProposalRevision[] @relation("QuoteProposalRevisionVendor")
  notifications           Notification[]        @relation("UserNotifications")
  activityLogs            ActivityLog[]         @relation("ActivityActor")

  @@index([role, isActive])
}

model EventPlan {
  id               String         @id @default(cuid())
  ownerId          String
  title            String
  slug             String         @unique
  type             EventType
  status           EventStatus    @default(PLANNING)
  hostName         String?
  honoreeName      String?
  venueName        String?
  region           String?
  scheduledAt      DateTime?
  guestTarget      Int?
  budget           Int?
  description      String?
  coverImageUrl    String?
  aiRecommendation Json?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  owner            User           @relation("EventOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  reservations     Reservation[]
  quoteRequests    QuoteRequest[]
  posts            Post[]         @relation("EventPosts")
  reviews          Review[]       @relation("EventReviews")
  invitations      Invitation[]
  planTransactions Transaction[]  @relation("PlanTransactions")

  @@index([ownerId, status])
  @@index([type, scheduledAt])
}

model Reservation {
  id                      String            @id @default(cuid())
  eventPlanId             String
  vendorId                String
  serviceName             String
  serviceCategory         String?
  description             String?
  serviceDate             DateTime?
  guestCount              Int?
  quotedAmount            Int?
  confirmedAmount         Int?
  selectedServiceOptions  Json?
  quoteRequestId          String?           @unique
  quoteResponseId         String?           @unique
  quoteProposalRevisionId String?           @unique
  vendorConfirmationDueAt DateTime?
  status                  ReservationStatus @default(PENDING)
  notes                   String?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  eventPlan               EventPlan         @relation(fields: [eventPlanId], references: [id], onDelete: Cascade)
  vendor                  User              @relation("ReservationVendor", fields: [vendorId], references: [id])
  quoteRequest            QuoteRequest?     @relation(fields: [quoteRequestId], references: [id], onDelete: SetNull)
  quoteResponse           QuoteResponse?    @relation(fields: [quoteResponseId], references: [id], onDelete: SetNull)
  quoteProposalRevision   QuoteProposalRevision? @relation(fields: [quoteProposalRevisionId], references: [id], onDelete: SetNull)
  transaction             Transaction?
  reviews                 Review[]          @relation("ReservationReviews")

  @@index([eventPlanId, status])
  @@index([vendorId, status])
}

model Post {
  id          String       @id @default(cuid())
  authorId    String
  eventPlanId String?
  title       String
  slug        String       @unique
  excerpt     String?
  content     String
  category    PostCategory @default(STORY)
  isPublished Boolean      @default(false)
  publishedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  author      User         @relation("PostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  eventPlan   EventPlan?   @relation("EventPosts", fields: [eventPlanId], references: [id], onDelete: SetNull)

  @@index([authorId, category])
  @@index([eventPlanId, isPublished])
}

model Review {
  id            String       @id @default(cuid())
  authorId      String
  vendorId      String?
  eventPlanId   String?
  reservationId String?
  rating        Int
  title         String?
  content       String
  isPublished   Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  author        User         @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  vendor        User?        @relation("ReviewVendor", fields: [vendorId], references: [id], onDelete: SetNull)
  eventPlan     EventPlan?   @relation("EventReviews", fields: [eventPlanId], references: [id], onDelete: SetNull)
  reservation   Reservation? @relation("ReservationReviews", fields: [reservationId], references: [id], onDelete: SetNull)

  @@index([vendorId, rating])
  @@index([eventPlanId, isPublished])
}

model Transaction {
  id               String            @id @default(cuid())
  reservationId    String?           @unique
  payerId          String?
  planId           String?
  senderName       String?
  amount           Int
  relation         String?
  message          String?
  type             TransactionType   @default(OFFLINE)
  status           TransactionStatus @default(PENDING)
  method           TransactionMethod @default(MOCK)
  gatewayReference String?
  paidAt           DateTime?
  failureReason    String?
  receiptUrl       String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  reservation      Reservation?      @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  payer            User?             @relation("TransactionPayer", fields: [payerId], references: [id], onDelete: Cascade)
  plan             EventPlan?        @relation("PlanTransactions", fields: [planId], references: [id], onDelete: Cascade)

  @@index([payerId, status])
  @@index([planId, type])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  href      String?
  readAt    DateTime?
  metadata  Json?
  createdAt DateTime  @default(now())
  user      User      @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([type, createdAt])
}

model ActivityLog {
  id              String   @id @default(cuid())
  actorId         String?
  planId          String?
  vendorId        String?
  quoteRequestId  String?
  quoteResponseId String?
  reservationId   String?
  type            String
  message         String
  metadata        Json?
  createdAt       DateTime @default(now())
  actor           User?    @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([planId, createdAt])
  @@index([vendorId, createdAt])
  @@index([quoteRequestId, createdAt])
  @@index([reservationId, createdAt])
  @@index([type, createdAt])
}

model Invitation {
  id             String           @id @default(cuid())
  eventPlanId    String
  senderId       String
  recipientId    String?
  templateId     String?
  shareUrl       String?          @unique
  content        Json?
  isPublished    Boolean          @default(false)
  recipientName  String
  recipientPhone String?
  recipientEmail String?
  message        String?
  rsvpStatus     InvitationStatus @default(DRAFT)
  attendees      Int?
  invitationCode String           @unique
  sentAt         DateTime?
  viewedAt       DateTime?
  respondedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  eventPlan      EventPlan        @relation(fields: [eventPlanId], references: [id], onDelete: Cascade)
  sender         User             @relation("InvitationSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient      User?            @relation("InvitationRecipient", fields: [recipientId], references: [id], onDelete: SetNull)

  @@index([eventPlanId, rsvpStatus])
}

model VendorServiceModule {
  id             String         @id @default(cuid())
  vendorId       String
  name           String
  category       ModuleCategory
  price          Int
  pricingType    String         @default("FLAT")
  description    String?
  isBaseIncluded Boolean        @default(false)
  isActive       Boolean        @default(true)
  sortOrder      Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  vendor         User           @relation("VendorServiceModules", fields: [vendorId], references: [id], onDelete: Cascade)
  packageItems   VendorPackageModule[]

  @@index([vendorId, category, isActive])
}

model VendorPackage {
  id          String                @id @default(cuid())
  vendorId    String
  eventType   EventType
  name        String
  description String?
  basePrice   Int
  isActive    Boolean               @default(false)
  sortOrder   Int                   @default(0)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  vendor      User                  @relation("VendorPackages", fields: [vendorId], references: [id], onDelete: Cascade)
  items       VendorPackageModule[]
  quoteRequests QuoteRequest[]

  @@index([vendorId, eventType, isActive])
  @@index([vendorId, eventType, sortOrder])
}

model VendorPackageModule {
  id                    String                           @id @default(cuid())
  packageId             String
  vendorServiceModuleId String
  selectionType         VendorPackageModuleSelectionType
  quantity              Int                              @default(1)
  priceOverride         Int?
  sortOrder             Int                              @default(0)
  createdAt             DateTime                         @default(now())
  updatedAt             DateTime                         @updatedAt
  package               VendorPackage                    @relation(fields: [packageId], references: [id], onDelete: Cascade)
  vendorServiceModule   VendorServiceModule              @relation(fields: [vendorServiceModuleId], references: [id], onDelete: Cascade)

  @@unique([packageId, vendorServiceModuleId])
  @@index([packageId, selectionType])
  @@index([vendorServiceModuleId])
}

model QuoteRequest {
  id              String          @id @default(cuid())
  planId          String
  vendorId        String
  selectedPackageId String?
  requirements    String
  selectedModules Json?
  selectedPackageSnapshot Json?
  priceSnapshot   Json?
  preferredDate   DateTime?
  preferredDateStart DateTime?
  preferredDateEnd DateTime?
  budget          Int?
  status          QuoteStatus     @default(PENDING)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  plan            EventPlan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  vendor          User            @relation("QuoteRequestVendor", fields: [vendorId], references: [id], onDelete: Cascade)
  selectedPackage VendorPackage?  @relation(fields: [selectedPackageId], references: [id], onDelete: SetNull)
  responses       QuoteResponse[]
  proposalRevisions QuoteProposalRevision[]
  reservation     Reservation?

  @@index([planId, status])
  @@index([vendorId, status])
}

model QuoteResponse {
  id          String       @id @default(cuid())
  requestId   String
  vendorId    String
  basePrice   Int
  modules     Json
  totalPrice  Int
  note        String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  request     QuoteRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  vendor      User         @relation("QuoteResponseVendor", fields: [vendorId], references: [id], onDelete: Cascade)
  reservation Reservation?
  revisions   QuoteProposalRevision[]

  @@unique([requestId, vendorId])
  @@index([requestId])
  @@index([vendorId])
}

model QuoteProposalRevision {
  id                    String                      @id @default(cuid())
  quoteResponseId       String
  requestId             String
  vendorId              String
  version               Int
  totalPrice            Int
  memo                  String?
  adjustmentRequestMemo String?
  plannerRequestedTotalPrice Int?
  proposedServiceDate  DateTime?
  status                QuoteProposalRevisionStatus @default(SUBMITTED)
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  quoteResponse         QuoteResponse               @relation(fields: [quoteResponseId], references: [id], onDelete: Cascade)
  request               QuoteRequest                @relation(fields: [requestId], references: [id], onDelete: Cascade)
  vendor                User                        @relation("QuoteProposalRevisionVendor", fields: [vendorId], references: [id], onDelete: Cascade)
  reservation           Reservation?

  @@unique([quoteResponseId, version])
  @@index([requestId, createdAt])
  @@index([vendorId, status])
}

model VendorService {
  id          String                @id @default(cuid())
  vendorId    String
  eventType   String
  module      String
  catalogKey  String?
  pricingType String                @default("FLAT")
  name        String
  description String?
  basePrice   Int
  maxGuests   Int?
  isActive    Boolean               @default(true)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  vendor      User                  @relation("VendorServices", fields: [vendorId], references: [id], onDelete: Cascade)
  options     VendorServiceOption[]

  @@index([vendorId, eventType])
  @@index([eventType, module])
  @@index([eventType, module, catalogKey])
}

model VendorServiceOption {
  id              String        @id @default(cuid())
  vendorServiceId String
  name            String
  description     String?
  additionalPrice Int
  pricingType     String        @default("FLAT")
  isRequired      Boolean       @default(false)
  sortOrder       Int           @default(0)
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  vendorService   VendorService @relation(fields: [vendorServiceId], references: [id], onDelete: Cascade)

  @@index([vendorServiceId, isActive])
}
